{
  "schema_version": 1,
  "project": "laemp",
  "purpose": "Maintained host Moodle installer with Docker, Lima and Slicer verification.",
  "actions": [
    {
      "id": "verify",
      "intent": "Execute the complete configured local gate before publishing this repository.",
      "argv": [
        "lefthook",
        "run",
        "pre-push",
        "--force"
      ],
      "effects": [
        "read",
        "local_write",
        "process",
        "network"
      ],
      "acceptance_scope": "fixture",
      "inputs": [
        "lefthook.yml",
        "Makefile",
        "package.json",
        "pyproject.toml",
        "uv.lock",
        "tests/security/test_installer_secrecy.py",
        "laemp.sh",
        ".npmrc",
        "platforms/docker/tls-preflight.sh",
        "scripts/hooks/check-staged-shell.sh",
        "scripts/hooks/lib.sh",
        "scripts/hooks/run-local-ci.sh",
        "tests/README.md",
        "tests/bats/test_docker_ports.bats",
        "tests/bats/test_integration.bats",
        "tests/bats/test_laemp.bats",
        "tests/bats/test_smoke.bats",
        "tests/bats/test_tls_preflight.bats",
        "tests/bats/test_verify_moodle.bats",
        "tests/docker/lib.sh",
        "tests/docker/run-baseline.sh",
        "tests/docker/run-matrix.sh",
        "tests/e2e/moodle.spec.ts",
        "tests/e2e/slicer-smoke.spec.ts",
        "tests/e2e/vm-smoke.spec.ts",
        "tests/security/test_installer_backend_flow.py",
        "tests/security/test_installer_storage.py",
        "tests/slicer/lib.sh",
        "tests/slicer/run-matrix.sh",
        "tests/slicer/run-test.sh",
        "tests/slicer/test-laemp.sh",
        "verify-moodle.sh",
        "tests/bats/local-gate-refusal.bats"
      ],
      "requires": [],
      "recovery": "Read the failed owner job; repair its source or declared prerequisite, then rerun the full local gate. Fixture acceptance does not authorize cloud/device deployment."
    },
    {
      "id": "verify-lesson",
      "intent": "Re-evaluate the retained domain decision using its owning regression/contract.",
      "argv": [
        "uv",
        "run",
        "--locked",
        "make",
        "test-security"
      ],
      "effects": [
        "read",
        "local_write",
        "process",
        "network"
      ],
      "acceptance_scope": "fixture",
      "inputs": [
        "tests/security/test_installer_secrecy.py",
        "laemp.sh",
        "Makefile",
        "package.json",
        "pyproject.toml",
        "uv.lock",
        "lefthook.yml",
        ".npmrc"
      ],
      "requires": [],
      "recovery": "Inspect the named source/test and reproduce the failing synthetic case before reusing this lesson."
    }
  ],
  "learning": [
    {
      "id": "owner-invariant",
      "when": [
        "installer",
        "secret",
        "privacy"
      ],
      "summary": "Synthetic credential-flow fixtures protect installer secrets; dry-run and static shell lint do not establish attended installation success.",
      "owner": "tests/security/test_installer_secrecy.py",
      "basis": [
        {
          "path": "tests/security/test_installer_secrecy.py",
          "sha256": "82b680c1fa0762bcc89bc4dc856b31ab82cbd7476f2680819f23b46388acc60a"
        },
        {
          "path": "laemp.sh",
          "sha256": "8134b349d99c520cd31840be8b5fc11e6a831251fa9fbad8db99b4f7398dbd46"
        }
      ],
      "verify_action": "verify-lesson"
    },
    {
      "id": "full-gate-refusal",
      "when": [
        "gate",
        "skip",
        "recursive",
        "verification"
      ],
      "summary": "Skipped or recursive full-gate execution is not acceptance. Execute mode refuses those conditions before effects; preview remains read-only. The required fixture job proves both refusals and the preview control.",
      "owner": "scripts/hooks/run-local-ci.sh",
      "basis": [
        {
          "path": "scripts/hooks/run-local-ci.sh",
          "sha256": "dea29cf9e53eddbe5c14344a2dfd3e653aaceb3632c1f14004c4029ad1822bbe"
        },
        {
          "path": "tests/bats/local-gate-refusal.bats",
          "sha256": "fcffe678437bac6a8a552187086a116bad44fd185ec0ba0ac1799467d37dcf86"
        }
      ],
      "verify_action": "verify"
    }
  ]
}
