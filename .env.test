# E2E Test Configuration
# Copy these values from /var/lib/laemp/moodle-admin-credentials.env

# Moodle URL
# Docker defaults to 80/443 on the split FQDNs.
# Override these only if you explicitly run the harness on non-default ports.
# For Slicer runs, override this with the VM-specific host, e.g.
# https://moodle.slicer.test.192.168.64.2.sslip.io
MOODLE_URL=https://moodle.docker.test.127.0.0.1.sslip.io
MOODLE_HTTP_URL=http://moodle.docker.test.127.0.0.1.sslip.io

# Admin credentials (generated during installation)
MOODLE_ADMIN_USERNAME=admin
MOODLE_ADMIN_PASSWORD=CHANGE_ME_FROM_CREDENTIALS_FILE
MOODLE_ADMIN_EMAIL=demo@moodle.docker.test

# Test configuration
MOODLE_SITE_NAME=moodle.docker.test.127.0.0.1.sslip.io
